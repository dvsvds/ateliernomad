# ─────────────────────────────────────────────────────────────
# Atelier Nomad — omgevingsvariabelen
# Kopieer dit bestand naar ".env" en vul je eigen Stripe-sleutels in.
# ─────────────────────────────────────────────────────────────

# Publieke Stripe-sleutel (begint met pk_). Veilig in de front-end.
VITE_STRIPE_PUBLISHABLE_KEY=      # plak hier je publieke sleutel (pk_test_... of pk_live_...)

# URL van je serverless checkout-functie.
# Vercel:  /api/create-checkout-session
# Netlify: /.netlify/functions/create-checkout-session
VITE_CHECKOUT_ENDPOINT=/api/create-checkout-session

# ─── Alleen op de server (NOOIT in de front-end) ───
STRIPE_SECRET_KEY=                # plak hier je geheime sleutel (sk_test_... of sk_live_...)
SITE_URL=http://localhost:5173
